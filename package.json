{
  "name": "suriq-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "lint": "eslint src remotion remotion.config.ts next.config.ts eslint.config.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "remotion:studio": "remotion studio",
    "remotion:render": "remotion render SuriqIntro out/suriq-intro.mp4",
    "remotion:still": "remotion still SuriqIntro out/suriq-intro.png --frame=45"
  },
  "dependencies": {
    "lucide-react": "^0.553.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.541",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
